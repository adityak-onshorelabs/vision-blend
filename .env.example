# Public URL used for canonical links, sitemap and Open Graph (link previews). Set it only once
# the domain is connected: until then, leaving it unset uses Vercel's production URL so WhatsApp
# and other previews can load the image.
NEXT_PUBLIC_SITE_URL=

# Content saved in the admin (separate deployment, ../admin). Neon Postgres connection string,
# the same database the admin writes; unset locally, the site reads .cms-dev.json.
DATABASE_URL=
# 32+ random characters, the same as the admin's CMS_SECRET: authorises /api/cms.
CMS_SECRET=

# Enquiry email delivery through Resend (https://resend.com). Without these,
# development logs the brief to the console and production returns 503.
RESEND_API_KEY=
# Comma-separated list of recipients
ENQUIRY_TO=
# A sender on a domain verified in Resend, e.g. "Vision Blend <briefs@visionblend.in>"
ENQUIRY_FROM=

# Cloudflare Turnstile (invisible human check on the enquiry form). Create a widget for this
# domain in the Cloudflare dashboard. Development falls back to Cloudflare's test keys; in
# production, leaving both empty turns the check off. Set both or neither: a secret without
# the site key rejects every enquiry. The site key is read at build time, so redeploy after
# changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
