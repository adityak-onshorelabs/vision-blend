# Public URL used for canonical links, sitemap and Open Graph (link previews). Set it only once
# the domain is connected: until then, leaving it unset uses Vercel's production URL so WhatsApp
# and other previews can load the image.
NEXT_PUBLIC_SITE_URL=

# Content saved in the admin (separate deployment, ../admin). Railway Postgres: its DATABASE_PUBLIC_URL (Vercel connects from outside Railway),
# the same database the admin writes; unset locally, the site reads .cms-dev.json.
DATABASE_URL=
# 32+ random characters, the same as the admin's CMS_SECRET: authorises /api/cms.
CMS_SECRET=

# Cloudflare Turnstile (invisible human check on the enquiry form). Create a widget for this
# domain in the Cloudflare dashboard. Development falls back to Cloudflare's test keys; in
# production, leaving both empty turns the check off. Set both or neither: a secret without
# the site key rejects every enquiry. The site key is read at build time, so redeploy after
# changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs the cookie that unlocks an industry portfolio after its enquiry (src/lib/gate.ts).
# 32+ random characters. Falls back to CMS_SECRET; with neither, production portfolios stay locked.
GATE_SECRET=

# Google Sheet: the only place form submissions go (one tab per form, no email). Set up the sheet's
# Apps Script web app from scripts/google-sheets/Code.gs, then paste its /exec URL and the SECRET
# here. Without them, submissions are only logged (Vercel function logs in production).
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
